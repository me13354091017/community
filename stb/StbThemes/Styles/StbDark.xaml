<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- STB 品牌深色覆盖：石墨黑板底 + 暖琥珀点缀。
         进入黑板模式 / PPT 放映深色覆盖时生效；同名键优先命中这里，未列出的键回落到上游 Dark.xaml。 -->

    <!-- 浮动栏 -->
    <SolidColorBrush x:Key="FloatBarBackground" Color="#F212171E" />
    <SolidColorBrush x:Key="FloatBarBackgroundWithoutOpacity" Color="#FF12171E" />
    <SolidColorBrush x:Key="FloatBarTitleBackground" Color="#3DE9A23B" />
    <SolidColorBrush x:Key="FloatBarBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="FloatBarForeground" Color="#FFF3F5F7" />
    <Color x:Key="FloatBarForegroundColor">#FFF3F5F7</Color>

    <!-- 浮动栏按钮三态 -->
    <SolidColorBrush x:Key="FloatBarButtonBackgroundKey" Color="Transparent" />
    <SolidColorBrush x:Key="FloatBarButtonBackgroundPointerOverKey" Color="#33E9A23B" />
    <SolidColorBrush x:Key="FloatBarButtonButtonBackgroundPressedKey" Color="#55E9A23B" />

    <!-- 白板/黑板模式浮动栏 -->
    <SolidColorBrush x:Key="BoardFloatBarBackground" Color="#FF1A2028" />
    <SolidColorBrush x:Key="BoardFloatBarBorderBrush" Color="#FF39414D" />
    <SolidColorBrush x:Key="BoardFloatBarSelectedBackground" Color="#FFE9A23B" />
    <SolidColorBrush x:Key="BoardFloatBarSelectedBorderBrush" Color="#FFE9A23B" />
    <SolidColorBrush x:Key="BoardFloatBarSelectedForeground" Color="#FF14171C" />
    <SolidColorBrush x:Key="BoardFloatBarButtonBackgroundKey" Color="Transparent" />
    <SolidColorBrush x:Key="BoardFloatBarButtonBackgroundPointerOverKey" Color="#33E9A23B" />
    <SolidColorBrush x:Key="BoardFloatBarButtonButtonBackgroundPressedKey" Color="#55E9A23B" />

    <!-- 更多功能弹窗 -->
    <SolidColorBrush x:Key="ToolsPopupBackground" Color="#FF161C24" />
    <SolidColorBrush x:Key="ToolsPopupInnerBackground" Color="#FF1F262F" />
    <SolidColorBrush x:Key="ToolsPopupInnerBorderBrush" Color="#FF333C47" />
    <SolidColorBrush x:Key="ToolsPopupTitleForeground" Color="#FFF2C078" />

    <!-- 设置页 -->
    <SolidColorBrush x:Key="SettingsPageForeground" Color="#FFEDF0F3" />
    <SolidColorBrush x:Key="SettingsPageAnnotationForeground" Color="#FF9AA2AC" />
    <SolidColorBrush x:Key="SettingsPageBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SettingsPageBackground" Color="#F2161B22" />

    <!-- 文字与图标 -->
    <SolidColorBrush x:Key="IconForeground" Color="#FFEDF0F3" />
    <SolidColorBrush x:Key="TextForeground" Color="#FFEDF0F3" />

    <!-- 快抽 -->
    <SolidColorBrush x:Key="QuickDrawFloatingButtonBackground" Color="#CC12171E" />
    <SolidColorBrush x:Key="QuickDrawFloatingButtonBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="QuickDrawFloatingButtonIconForeground" Color="#FFF3F5F7" />
    <SolidColorBrush x:Key="QuickDrawWindowBackground" Color="#FF161C24" />
    <SolidColorBrush x:Key="QuickDrawWindowBorderBrush" Color="#FF333C47" />
    <SolidColorBrush x:Key="QuickDrawWindowTitleForeground" Color="#FFEDF0F3" />
    <SolidColorBrush x:Key="QuickDrawWindowDigitForeground" Color="#FFEDF0F3" />

    <!-- 历史回滚 -->
    <SolidColorBrush x:Key="HistoryWindowPrimaryBrush" Color="#FFE9A23B" />
    <SolidColorBrush x:Key="HistoryWindowPrimaryHoverBrush" Color="#FFF2C078" />
    <SolidColorBrush x:Key="HistoryWindowPrimaryPressedBrush" Color="#FFC98627" />
    <SolidColorBrush x:Key="HistoryWindowCardBackgroundBrush" Color="#FF1D242D" />
    <SolidColorBrush x:Key="HistoryWindowCardBorderBrush" Color="#FF2F3843" />
    <SolidColorBrush x:Key="HistoryWindowTextPrimaryBrush" Color="#FFE8ECF1" />
    <SolidColorBrush x:Key="HistoryWindowTextSecondaryBrush" Color="#FF9AA2AC" />

    <!-- 通用色 -->
    <SolidColorBrush x:Key="RedBrush" Color="#FFF26B5E" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#FFB49BE8" />
</ResourceDictionary>
